fn factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

fn fibonacci(n: int) -> int {
    if n <= 1 { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() {
    println("Factorial of 10:")
    println(factorial(10))

    println("Fibonacci sequence:")
    for i in range(10) {
        print(fibonacci(i))
        print(" ")
    }
    println("")
}

main()
