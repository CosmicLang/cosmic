// Enums in Cosmic
// Demonstrates: simple enums, enums with data, match expressions

enum Color {
    RED,
    GREEN,
    BLUE
}

enum Direction {
    NORTH,
    SOUTH,
    EAST,
    WEST
}

enum Shape {
    Circle(float),
    Rect(float, float),
    Triangle(float, float, float)
}

fn describe_color(c: Color) -> string {
    if c == Color.RED {
        return "Red"
    } elif c == Color.GREEN {
        return "Green"
    } elif c == Color.BLUE {
        return "Blue"
    } else {
        return "Unknown"
    }
}

fn shape_area(s: Shape) -> float {
    match s {
        Circle(r) => 3.14159 * r * r,
        Rect(w, h) => w * h,
        Triangle(a, b, c) => (a + b + c) / 2,
    }
}

fn move(d: Direction) -> string {
    match d {
        Direction.NORTH => "Moving north",
        Direction.SOUTH => "Moving south",
        Direction.EAST => "Moving east",
        Direction.WEST => "Moving west",
    }
}

fn main() {
    // Simple enum usage
    let c = Color.BLUE
    println(describe_color(c))

    // Direction enum
    println(move(Direction.NORTH))
    println(move(Direction.EAST))

    // Enums with data
    let shapes = [Circle(5.0), Rect(4.0, 6.0), Triangle(3.0, 4.0, 5.0)]
    for s in shapes {
        println("Area: " + str(shape_area(s)))
    }
}

main()
