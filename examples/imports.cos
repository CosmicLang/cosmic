// Imports in Cosmic
// Demonstrates: import, from-import, using stdlib modules

// Import entire module
import math

// Import specific names
from strings import uppercase, lowercase

fn main() {
    // Using imported math functions
    println("pi = " + str(math.pi))
    println("sqrt(16) = " + str(math.sqrt(16.0)))
    println("ceil(4.2) = " + str(math.ceil(4.2)))
    println("floor(4.8) = " + str(math.floor(4.8)))

    // Using from-imported string functions
    println(uppercase("hello"))
    println(lowercase("WORLD"))

    // Module as namespace
    println("max(10, 20) = " + str(math.floor(10.5)))
    println("gcd(12, 8) = " + str(math.gcd(12, 8)))
}

main()
